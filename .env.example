# ============================================
# SplitTs Environment Variables
# ============================================
# Fill in your actual keys below.
# This file should NEVER be committed to git.

# --- Razorpay ---
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# This is the same as RAZORPAY_KEY_ID but exposed to the client
NEXT_PUBLIC_RAZORPAY_KEY_ID=

